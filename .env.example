# 宿主机映射端口（Docker）
CIALLO_PORT=8080

# 上游 OpenAI 兼容网关（可带或不带 /v1）
# Docker 用这个；本地 npm run dev 也可用同值写到 VITE_DEV_PROXY_TARGET
CIALLO_UPSTREAM=https://your-grok2api.example.com

# 管理页解锁密码（写入 .env，不要提交仓库）
# 留空 = 不设门禁；设置后进入「管理」需输入密码（会话内有效）
CIALLO_ADMIN_PASSWORD=change-me

# 本地开发（npm run dev）把浏览器 /v1 反代到这里
# 例: https://your-grok2api.example.com  或  http://127.0.0.1:8000
VITE_DEV_PROXY_TARGET=https://your-grok2api.example.com

# 镜像固定为 ghcr.io/murasamecyan/ciallostudio:beta（见 docker-compose.yml）
# compose 只 pull，不本地 build

TZ=Asia/Shanghai
