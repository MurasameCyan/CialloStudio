# 仅 Docker 部署用（上游与 API Key 在网页管理页配置）
CIALLO_PORT=8080

# 站长账号 = 社区 admin = 管理页唯一入口（无单独管理密码）
CIALLO_MASTER_USERNAME=admin
CIALLO_MASTER_PASSWORD=change-me

# CF 媒体存储（Telegram 反代）。部署见 docs/telegram-media-worker.md
# CIALLO_MEDIA_BASE=https://ciallo-media.pages.dev
# CIALLO_MEDIA_UPLOAD_TOKEN=与 Pages/Worker UPLOAD_TOKEN 相同（可选）
