# 宿主机映射端口（Docker）
CIALLO_PORT=8080

# 上游 OpenAI 兼容网关（必填真实可解析地址，可带或不带 /v1）
# 错误示例: https://your-grok2api.example.com  ← 会导致旧镜像启动失败 / 新镜像 /v1=503
# 正确示例: https://grokb.yuzu.gv.uy  或  http://host.docker.internal:8000
CIALLO_UPSTREAM=https://your-real-gateway.example

# 管理页解锁密码（写入 .env，不要提交仓库）
# 留空 = 不设门禁；设置后进入「管理」需输入密码（会话内有效）
CIALLO_ADMIN_PASSWORD=change-me

# 本地开发（npm run dev）把浏览器 /v1 反代到这里
# 例: https://your-grok2api.example.com  或  http://127.0.0.1:8000
VITE_DEV_PROXY_TARGET=https://your-grok2api.example.com

TZ=Asia/Shanghai
