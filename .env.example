# 仅 Docker 部署用（上游与 API Key 在网页管理页配置）
CIALLO_PORT=8080

# 站长账号 = 社区 admin = 管理页唯一入口（无单独管理密码）
CIALLO_MASTER_USERNAME=admin
CIALLO_MASTER_PASSWORD=change-me

# 社区 API 模式（仅 env / runtime-config；前端不再切换）
# http = 默认。容器内 API + /data/community.json（推荐，用户跨重启保留）
# mock = 仅浏览器 localStorage（刷新/换浏览器会丢，不适合多用户）
CIALLO_COMMUNITY_MODE=http
# CIALLO_COMMUNITY_API_BASE=/api/community
# CIALLO_DATA_DIR=/data

# CF 媒体存储（Telegram 反代）。部署见 docs/telegram-media-worker.md
# 两个 Base 都只填根域名（不要带 /v1 路径）
# CIALLO_MEDIA_BASE=https://ciallo-media.pages.dev
# CIALLO_MEDIA_UPLOAD_TOKEN=与 Pages/Worker UPLOAD_TOKEN 相同（可选）
# 上游图片站公网根域名（后台队列 Site 模式改写 127.0.0.1 媒体链）
# CIALLO_SITE_BASE=https://img.example.com
# 后台队列默认储存：site | media（可被管理页 localStorage 覆盖）
# CIALLO_QUEUE_STORAGE_MODE=site

# 上游 SSRF：默认只允许公网 http(s)。本机/内网 API 需白名单（逗号分隔）
# 写法：完整 origin / host:port / host
# 例：本机 grok2api、Docker 宿主机
# CIALLO_UPSTREAM_ALLOWLIST=http://127.0.0.1:8000,host.docker.internal,192.168.1.10:9000
# 调试接口 GET /debug/upstream?url=https://... （设 0 关闭）
# CIALLO_DEBUG_UPSTREAM=1

# 版本检测（可选；镜像构建时已由 CI 注入，一般无需手写）
# CIALLO_BUILD_ID=  # git full/short SHA
# CIALLO_TRACK_REF=beta
# CIALLO_GITHUB_REPO=MurasameCyan/CialloStudio

# 创作台「模板」默认词库（可选）。用户首次打开模板弹窗且本地词库为空时，
# 从这个地址拉一次存进浏览器 localStorage；之后完全归用户自己维护，
# 换了地址或内容也不会覆盖用户已导入的词库（想重新拉取要在弹窗里清空）。
# 上限 512 KB，必须返回 JSON（格式见 scripts/convert-prompt-library.mjs 的输出）。
#
# 默认走约定路径 /prompt-templates.json，所以自带词库只需在 docker-compose.yml 挂文件：
#   - ./prompt-templates.json:/usr/share/nginx/html/prompt-templates.json:ro
# 不挂也不报错，用户自己在弹窗里导入即可。
#
# 下面这行只在词库放在别处时才需要（外部地址须允许跨域，否则浏览器会拦掉）。
# 一旦显式配置，拉不到就会在弹窗里报错——地址写错能立刻发现。
# CIALLO_PROMPT_TEMPLATES_URL=https://example.com/prompt-templates.json
