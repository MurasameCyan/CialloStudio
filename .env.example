# 仅 Docker 部署用（上游与 API Key 在网页管理页配置）
CIALLO_PORT=8080

# 站长账号（社区 admin + 管理页权限）。密码只进容器环境，前端仅持有 sha256。
CIALLO_MASTER_USERNAME=admin
CIALLO_MASTER_PASSWORD=change-me

# 旧变量（兼容）：若未设 CIALLO_MASTER_PASSWORD，可当作站长密码
# CIALLO_ADMIN_PASSWORD=

# CF Worker 媒体存储（Telegram 反代）。部署见 docs/telegram-media-worker.md
# CIALLO_MEDIA_BASE=https://ciallo-telegram-media.<subdomain>.workers.dev
# CIALLO_MEDIA_UPLOAD_TOKEN=与 Worker secret UPLOAD_TOKEN 相同（可选）
